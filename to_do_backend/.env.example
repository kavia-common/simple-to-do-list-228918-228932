# Backend server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# SQLite database file path.
# In this project, you can point to the shared DB created by the SQLite container, e.g.:
# SQLITE_DB=/home/kavia/workspace/code-generation/simple-to-do-list-228918-228934/database/myapp.db
SQLITE_DB=

# CORS allowlist for browser-based frontend (comma-separated).
# If empty, backend defaults to allowing all origins (dev-friendly).
# Example:
# CORS_ALLOWED_ORIGINS=https://vscode-internal-xxxxx-qa.qa01.cloud.kavia.ai:3000,http://localhost:3000
CORS_ALLOWED_ORIGINS=
